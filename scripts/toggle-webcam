#!/bin/bash
# Usage: toggle-webcam [on|off]   (no argument = toggle)

# Webcam USB ID from `v4l2-ctl` → usb-0000:00:14.0-3 → /sys/bus/usb/devices/1-3
DEVICE_ID="1-3"
DRIVER_PATH="/sys/bus/usb/drivers/usb"
DEVICE_PATH="/sys/bus/usb/devices/$DEVICE_ID"
NOTIFY_TITLE="Camera Status"

is_on() { [ -e "$DRIVER_PATH/$DEVICE_ID" ]; }
cam_off() { is_on && echo "$DEVICE_ID" | sudo tee "$DRIVER_PATH/unbind" > /dev/null; }
cam_on() { is_on || echo "$DEVICE_ID" | sudo tee "$DRIVER_PATH/bind" > /dev/null; }

case "$1" in
    off) cam_off ;;
    on) cam_on ;;
    *) if is_on; then cam_off; else cam_on; fi ;;
esac
exit 0
