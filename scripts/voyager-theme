#!/usr/bin/env bash
# Switch voyager between light and dark mode.
#
#   voyager-theme              print the current mode
#   voyager-theme toggle       flip it (bind this to a key)
#   voyager-theme light|dark   set it
#   voyager-theme apply        re-apply the saved mode (the installers run this)
#
# Saves the mode to ~/.config/voyager/theme, then runs every hook in
# ~/.config/voyager/theme.d/ with the mode as its argument. Each component's
# installer adds its own hook, so this script knows nothing about eww or dunst.
# A failing hook is reported and the others still run.
#
# Docs: README.md#light-and-dark

set -uo pipefail

CONF="$HOME/.config/voyager"
STATE="$CONF/theme"
HOOKS="$CONF/theme.d"

current() { [[ $(cat "$STATE" 2>/dev/null) == dark ]] && echo dark || echo light; }

case "${1:-}" in
  "")         current; exit ;;
  toggle)     [[ $(current) == dark ]] && mode=light || mode=dark ;;
  light|dark) mode=$1 ;;
  apply)      mode=$(current) ;;
  *) echo "usage: voyager-theme [toggle|light|dark|apply]" >&2; exit 2 ;;
esac

mkdir -p "$CONF"
echo "$mode" > "$STATE"

failed=0
for hook in "$HOOKS"/*; do
  [[ -f "$hook" && -x "$hook" ]] || continue
  if ! out=$("$hook" "$mode" 2>&1); then
    echo "voyager-theme: hook ${hook##*/} failed${out:+: $out}" >&2
    echo "  retry it alone:  $hook $mode" >&2
    failed=1
  fi
done

if [[ ${1:-} != apply ]]; then
  msg="$mode mode"; (( failed )) && msg+=" (a hook failed — run voyager-theme apply in a terminal)"
  notify-send -u low -t 2000 voyager "$msg" 2>/dev/null || true
fi
exit "$failed"
